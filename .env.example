# Optional LLM used ONLY for ambiguous request_text in the classification gate.
# Without these the pipeline runs fully deterministic (keyword rules + default).
LLM_PROVIDER=openai_compat      # informational
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-...              # or OPENAI_API_KEY
LLM_BASE_URL=https://api.openai.com/v1

# Optional Tesseract path for OCR of PNG evidence (binary, not a secret key):
# TESSERACT_CMD=/usr/bin/tesseract
